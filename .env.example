# Compose publishes only nginx; the API stays on the Docker network.
# Open exactly http://127.0.0.1:8585 with the defaults below.
# Changing CDP_PORT also changes the default canonical URL.
#CDP_PORT=8585
# Set the actual browser origin when using another hostname or external HTTPS.
#ACCESS_PUBLIC_URL=https://your-service.example.com
# CDP_PUBLIC_URL remains supported; if both URLs are set, their origins must match.

# 複製成 .env 再改。全部都可以不設。

# docker compose 對外的 port
#CDP_PORT=8585

# 外部看到的網址（追蹤程式碼用它組）
#CDP_PUBLIC_URL=https://cdp.example.com

# 前面有反向代理（nginx、Caddy、Cloudflare…）時設 true
#CDP_TRUST_PROXY=true

# 同一個 IP 一分鐘最多送幾次資料（0 是不限制）
#CDP_RATE_LIMIT=600

# 事件留幾天，過期自動刪除（0 是不刪）
#CDP_RETENTION_DAYS=365

# Public OAuth client registration is optional; administrator registration stays available.
ACCESS_DYNAMIC_CLIENT_REGISTRATION=false

# Optional provider credentials; callback paths are /oauth/callback/github and /oauth/callback/google.
#ACCESS_GITHUB_CLIENT_ID=
#ACCESS_GITHUB_CLIENT_SECRET=
#ACCESS_GOOGLE_CLIENT_ID=
#ACCESS_GOOGLE_CLIENT_SECRET=
